{
	"name": "@deslop/template-app",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/template-app"
	},
	"bin": {
		"template-app": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"main": "src/main.client.tsx",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"preview": "vp run build && node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"dependencies": {
		"expo": "^58.0.24",
		"react": "latest",
		"react-native": "0.88.1"
	},
	"devDependencies": {
		"@deslop/components-mobile": "workspace:*",
		"@deslop/runtime": "workspace:*",
		"@effect/atom-react": "latest",
		"@expo/ui": "^58.0.28",
		"effect": "latest",
		"expo-auth-session": "^58.0.18",
		"expo-secure-store": "^58.0.3",
		"expo-updates": "^58.0.22",
		"expo-web-browser": "^58.0.8"
	},
	"config": {
		"port": 5100
	},
	"engines": {
		"node": ">=26"
	}
}
