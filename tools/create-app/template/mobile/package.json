{
	"name": "@deslop/template-app",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/template-app"
	},
	"bin": {
		"template-app": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"ios:add": "vp run build && cap add ios --packagemanager SPM && sh bin/ios-init.sh",
		"ios:sync": "vp run build && cap sync ios",
		"preview": "vp run build && NODE_ENV=development node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"devDependencies": {
		"@capacitor/cli": "latest",
		"@capacitor/core": "latest",
		"@capacitor/ios": "latest",
		"@deslop/runtime": "workspace:*",
		"@deslop/ui": "workspace:*",
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@87a704bef41b40de8fa7bced97cae5d69c4233a0",
		"effect": "latest"
	},
	"config": {
		"port": 5100
	},
	"engines": {
		"node": ">=26"
	}
}
