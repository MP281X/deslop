{
	"name": "@deslop/template-app",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/template-app"
	},
	"bin": {
		"template-app": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*",
		"#tools/*": "./src/tools/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp build && vp pack",
		"preview": "vp run build && NODE_ENV=development node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"devDependencies": {
		"@deslop/components-web": "workspace:*",
		"@deslop/runtime": "workspace:*",
		"@effect/atom-react": "latest",
		"@tanstack/react-router": "latest",
		"effect": "latest",
		"react": "latest",
		"react-dom": "latest"
	},
	"config": {
		"port": 5100
	},
	"engines": {
		"node": ">=26"
	}
}
