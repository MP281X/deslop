{
	"name": "@deslop/template-app",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/template-app"
	},
	"bin": {
		"template-app": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#contracts": "./src/contracts.ts",
		"#server/*": "./src/server/*",
		"#web/*": "./src/web/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"preview": "vp run build && NODE_ENV=development node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"devDependencies": {
		"@deslop/runtime": "workspace:*",
		"@deslop/ui": "workspace:*",
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@7bff56b3b81c57bf1038d358835e92833814a6b0",
		"effect": "latest"
	},
	"config": {
		"port": 5100
	},
	"engines": {
		"node": ">=26"
	}
}
