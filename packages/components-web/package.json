{
	"name": "@deslop/components-web",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/*"
	},
	"exports": {
		"./*": "./src/*.tsx",
		"./ui/*": "./src/ui/*.tsx",
		"./utils": "./src/lib/utils.ts",
		"./theme.css": "./src/theme.css"
	},
	"dependencies": {
		"@base-ui/react": "latest",
		"@fontsource-variable/jetbrains-mono": "latest",
		"@legendapp/list": "latest",
		"@lexical/react": "latest",
		"@pierre/diffs": "latest",
		"@tanstack/react-form": "latest",
		"@tanstack/react-hotkeys": "latest",
		"class-variance-authority": "latest",
		"clsx": "latest",
		"cmdk": "latest",
		"dompurify": "latest",
		"lexical": "latest",
		"lucide-react": "latest",
		"marked": "latest",
		"mermaid": "latest",
		"react-resizable-panels": "latest",
		"shadcn": "latest",
		"sonner": "latest",
		"tailwind-merge": "latest",
		"tailwindcss": "latest",
		"tw-animate-css": "latest"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	}
}
