{
	"name": "@deslop/components-web",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#lib/*": "./src/lib/*",
		"#components/*": "./src/*"
	},
	"exports": {
		"./app-bar": "./src/app-bar.tsx",
		"./fallbacks": "./src/fallbacks.tsx",
		"./ui/*": "./src/ui/*.tsx",
		"./utils": "./src/lib/utils.ts",
		"./theme.css": "./src/theme.css"
	},
	"scripts": {
		"test": "vp test --config ../../vite.config.ts",
		"typecheck": "tsrs --checkerAssignment go --pretty false"
	},
	"dependencies": {
		"@base-ui/react": "latest",
		"@fontsource-variable/geist": "latest",
		"@fontsource-variable/geist-mono": "latest",
		"class-variance-authority": "latest",
		"clsx": "latest",
		"effect": "latest",
		"input-otp": "latest",
		"lucide-react": "latest",
		"shadcn": "latest",
		"tailwind-merge": "latest",
		"tailwindcss": "latest",
		"tw-animate-css": "latest"
	},
	"devDependencies": {
		"@effect/platform-node": "latest",
		"@google/design.md": "latest"
	},
	"peerDependencies": {
		"react": "^19",
		"react-dom": "^19"
	}
}
