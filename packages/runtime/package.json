{
	"name": "@deslop/runtime",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#*": "./src/*"
	},
	"exports": {
		"./shared/*": "./src/shared/*.ts",
		"./server/*": "./src/server/*.ts",
		"./client/*": "./src/client/*.ts",
		"./web/*": "./src/web/*.ts",
		"./mobile/*": "./src/mobile/*.ts",
		"./config/fingerprint": "./src/config/fingerprint.js",
		"./config/*": "./src/config/*.ts"
	},
	"scripts": {
		"test": "vp test --config ../../vite.config.ts"
	},
	"dependencies": {
		"@effect/platform-node": "latest",
		"@effect/sql-sqlite-node": "latest",
		"effect": "latest"
	},
	"devDependencies": {
		"@tailwindcss/vite": "latest",
		"@tanstack/router-plugin": "latest",
		"@typeonce/effect-machine": "latest",
		"@vitejs/plugin-react": "latest",
		"expo": "^58.0.24",
		"expo-auth-session": "^58.0.18",
		"expo-constants": "^58.0.16",
		"expo-secure-store": "^58.0.3",
		"expo-updates": "^58.0.22",
		"oxc-transform-react": "^0.156.0",
		"react-native": "0.88.1"
	}
}
