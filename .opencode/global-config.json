{
	"$schema": "https://opencode.ai/config.json",
	"plugins": ["-opencode.tool.subagent", "-opencode.tool.question", "-opencode.tools"],
	"agents": {"plan": {"disabled": true}, "general": {"disabled": true}, "explore": {"disabled": true}},
	"policies": [
		{"action": "tool.use", "resource": "shell:python *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:python3 *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:sed -i*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:sed -E -i*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:sed --in-place*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:perl -i*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:perl -pi*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:cat >*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:cat <<*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin main", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin main *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin master", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin master *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin -f main", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin -f main *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin -f master", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin -f master *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --force main", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --force main *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --force master", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --force master *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --force-with-lease main", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --force-with-lease main *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --force-with-lease master", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --force-with-lease master *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin -d main", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin -d main *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin -d master", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin -d master *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --delete main", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --delete main *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --delete master", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *origin --delete master *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *:main", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *:main *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *:master", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *:master *", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *:refs/heads/main*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push *:refs/heads/master*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push * +main*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push * +master*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push * refs/heads/main*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push * refs/heads/master*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push * +refs/heads/main*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push * +refs/heads/master*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push*--all*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*git *push*--mirror*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh pr merge*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh pr review*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh stack *--open*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api*-X POST*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api*-X PUT*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api*-X PATCH*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api*-X DELETE*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api*--method POST*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api*--method PUT*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api*--method PATCH*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api*--method DELETE*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api graphql*=mutation*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*gh api graphql*'mutation*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab mr merge*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab mr approve*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api*-X POST*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api*-X PUT*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api*-X PATCH*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api*-X DELETE*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api*--method POST*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api*--method PUT*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api*--method PATCH*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api*--method DELETE*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api graphql*=mutation*", "effect": "deny"},
		{"action": "tool.use", "resource": "shell:*glab api graphql*'mutation*", "effect": "deny"}
	],
	"mcp": {
		"servers": {
			"dual": {"type": "remote", "url": "https://app.dualos.ai/mcp"},
			"scope": {"type": "remote", "url": "https://scope.mp281x.xyz/mcp"},
			"stash": {"type": "remote", "url": "https://stash.mp281x.xyz/mcp"},
			"mobbin": {"type": "remote", "url": "https://api.mobbin.com/mcp"}
		}
	}
}
