+
+// A file named like `logo@3x.png` loads at that scale, as UIKit's own image files do, so a 54-pixel file draws at 18
+// points. A `.template` in the name draws only its shape in the text color, as menus draw their symbols.
+private func scaledImage(data: Data, name: String) -> UIImage? {
+  let scale: CGFloat = name.contains("@3x") ? 3 : name.contains("@2x") ? 2 : 1
+  guard let image = UIImage(data: data, scale: scale) else { return nil }
+  return name.contains(".template") ? image.withRenderingMode(.alwaysTemplate) : image
+}
