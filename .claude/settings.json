{
	"disableBundledSkills": true,
	"syncClaudeAiSkills": false,
	"syncClaudeAiPlugins": false,
	"allowedMcpServers": [
		{"serverUrl": "http://127.0.0.1:*/mcp"},
		{"serverUrl": "https://app.dualos.ai/mcp"},
		{"serverUrl": "https://scope.mp281x.xyz/mcp"},
		{"serverUrl": "https://stash.mp281x.xyz/mcp"},
		{"serverUrl": "https://auth.mp281x.xyz/mcp"},
		{"serverUrl": "https://api.mobbin.com/mcp"}
	],
	"enabledPlugins": {
		"plugin-authoring@builtin": false,
		"mods-guide@builtin": false,
		"mermaid@builtin": false,
		"tips@builtin": false,
		"claude-test@builtin": false
	},
	"autoMemoryEnabled": false,
	"autoDreamEnabled": false,
	"disableWorkflows": true,
	"feedbackDrafts": "off",
	"includeGitInstructions": false,
	"agent": "pair",
	"attribution": {"commit": "", "pr": ""},
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "printf 'Execution worker: %s\\n' \"$(hostname -s)\"; (git -C ~/deslop pull --ff-only -q >/dev/null 2>&1 &)",
						"timeout": 5
					}
				]
			}
		]
	},
	"env": {
		"CLAUDE_CODE_DISABLE_CRON": "1",
		"CLAUDE_CODE_SKIP_PLUGIN_MCP_SERVERS": "1",
		"CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
		"CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
		"CLAUDE_CODE_ENABLE_CFC": "0",
		"BASH_DEFAULT_TIMEOUT_MS": "600000",
		"BASH_MAX_TIMEOUT_MS": "3000000",
		"CLAUDE_CODE_SILENT_TURN_REMINDER": "0",
		"CLAUDE_CODE_THRIFTY_SONIC": "0",
		"GLAB_PAGER": "cat",
		"NO_COLOR": "1"
	},
	"permissions": {
		"deny": [
			"Agent",
			"AskUserQuestion",
			"ListAgents",
			"SendMessage",
			"ScheduleWakeup",
			"RemoteTrigger",
			"EnterWorktree",
			"ExitWorktree",
			"EnterPlanMode",
			"ExitPlanMode",
			"Monitor",
			"PushNotification",
			"ReportFindings",
			"NotebookEdit",
			"DesignSync",
			"ClaudeDesign",
			"Artifact",
			"SendUserFile",
			"ShareOnboardingGuide",
			"EndConversation",
			"Bash(sed -i*)",
			"Bash(sed -E -i*)",
			"Bash(sed --in-place*)",
			"Bash(perl -i*)",
			"Bash(perl -pi*)",
			"Bash(cat >*)",
			"Bash(cat <<*)",
			"Bash(*git *push *origin main)",
			"Bash(*git *push *origin main *)",
			"Bash(*git *push *origin master)",
			"Bash(*git *push *origin master *)",
			"Bash(*git *push *origin -f main)",
			"Bash(*git *push *origin -f main *)",
			"Bash(*git *push *origin -f master)",
			"Bash(*git *push *origin -f master *)",
			"Bash(*git *push *origin --force main)",
			"Bash(*git *push *origin --force main *)",
			"Bash(*git *push *origin --force master)",
			"Bash(*git *push *origin --force master *)",
			"Bash(*git *push *origin --force-with-lease main)",
			"Bash(*git *push *origin --force-with-lease main *)",
			"Bash(*git *push *origin --force-with-lease master)",
			"Bash(*git *push *origin --force-with-lease master *)",
			"Bash(*git *push *origin -d main)",
			"Bash(*git *push *origin -d main *)",
			"Bash(*git *push *origin -d master)",
			"Bash(*git *push *origin -d master *)",
			"Bash(*git *push *origin --delete main)",
			"Bash(*git *push *origin --delete main *)",
			"Bash(*git *push *origin --delete master)",
			"Bash(*git *push *origin --delete master *)",
			"Bash(*git *push *:main)",
			"Bash(*git *push *:main *)",
			"Bash(*git *push *:master)",
			"Bash(*git *push *:master *)",
			"Bash(*git *push *:refs/heads/main*)",
			"Bash(*git *push *:refs/heads/master*)",
			"Bash(*git *push * +main*)",
			"Bash(*git *push * +master*)",
			"Bash(*git *push * refs/heads/main*)",
			"Bash(*git *push * refs/heads/master*)",
			"Bash(*git *push * +refs/heads/main*)",
			"Bash(*git *push * +refs/heads/master*)",
			"Bash(*git *push*--all*)",
			"Bash(*git *push*--mirror*)",
			"Bash(*gh pr merge*)",
			"Bash(*gh pr review*)",
			"Bash(*gh stack *--open*)",
			"Bash(*gh stack merge*)",
			"Bash(*gh api*-X POST*)",
			"Bash(*gh api*-X PUT*)",
			"Bash(*gh api*-X PATCH*)",
			"Bash(*gh api*-X DELETE*)",
			"Bash(*gh api*--method POST*)",
			"Bash(*gh api*--method PUT*)",
			"Bash(*gh api*--method PATCH*)",
			"Bash(*gh api*--method DELETE*)",
			"Bash(*gh api graphql*=mutation*)",
			"Bash(*gh api graphql*'mutation*)",
			"Bash(*glab mr merge*)",
			"Bash(*glab mr approve*)",
			"Bash(*glab api*-X POST*)",
			"Bash(*glab api*-X PUT*)",
			"Bash(*glab api*-X PATCH*)",
			"Bash(*glab api*-X DELETE*)",
			"Bash(*glab api*--method POST*)",
			"Bash(*glab api*--method PUT*)",
			"Bash(*glab api*--method PATCH*)",
			"Bash(*glab api*--method DELETE*)",
			"Bash(*glab api graphql*=mutation*)",
			"Bash(*glab api graphql*'mutation*)"
		]
	}
}
