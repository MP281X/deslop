{
	"disableBundledSkills": true,
	"disableClaudeAiConnectors": true,
	"syncClaudeAiSkills": false,
	"syncClaudeAiPlugins": false,
	"allowedMcpServers": [{"serverName": "t3-code"}],
	"enabledPlugins": {
		"plugin-authoring@builtin": false,
		"mods-guide@builtin": false,
		"mermaid@builtin": false,
		"tips@builtin": false,
		"claude-test@builtin": false
	},
	"autoMemoryEnabled": false,
	"autoDreamEnabled": false,
	"disableWorkflows": true,
	"disableAgentView": true,
	"disableRemoteControl": true,
	"spinnerTipsEnabled": false,
	"promptSuggestionEnabled": false,
	"feedbackDrafts": "off",
	"includeGitInstructions": false,
	"agent": "pair",
	"attribution": {"commit": "", "pr": ""},
	"bashOutputMaxChars": 60000,
	"env": {
		"ENABLE_TOOL_SEARCH": "false",
		"CLAUDE_CODE_DISABLE_CRON": "1",
		"CLAUDE_AGENT_SDK_DISABLE_BUILTIN_AGENTS": "1",
		"CLAUDE_CODE_SKIP_PLUGIN_MCP_SERVERS": "1",
		"CLAUDE_CODE_TODO_REMINDER_MODE": "off",
		"CLAUDE_CODE_AUTO_CONNECT_IDE": "false",
		"CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
		"CLAUDE_CODE_ENABLE_CFC": "0",
		"BASH_DEFAULT_TIMEOUT_MS": "600000",
		"BASH_MAX_TIMEOUT_MS": "3000000",
		"CLAUDE_CODE_SILENT_TURN_REMINDER": "0",
		"CLAUDE_CODE_THRIFTY_SONIC": "0",
		"NO_COLOR": "1"
	},
	"permissions": {
		"deny": [
			"Agent",
			"ListAgents",
			"SendMessage",
			"SubagentHandback",
			"Workflow",
			"ScheduleWakeup",
			"RemoteTrigger",
			"TaskCreate",
			"TaskGet",
			"TaskList",
			"TaskUpdate",
			"TodoWrite",
			"EnterWorktree",
			"ExitWorktree",
			"EnterPlanMode",
			"ExitPlanMode",
			"Monitor",
			"PushNotification",
			"ReportFindings",
			"NotebookEdit",
			"DesignSync",
			"ClaudeDesign",
			"Artifact",
			"SendUserFile",
			"SendFeedback",
			"ShareOnboardingGuide",
			"EndConversation",
			"Bash(*git *push * main)",
			"Bash(*git *push * main *)",
			"Bash(*git *push * master)",
			"Bash(*git *push * master *)",
			"Bash(*git *push *:main)",
			"Bash(*git *push *:main *)",
			"Bash(*git *push *:master)",
			"Bash(*git *push *:master *)",
			"Bash(*git *push *:refs/heads/main*)",
			"Bash(*git *push *:refs/heads/master*)",
			"Bash(*git *push * +main*)",
			"Bash(*git *push * +master*)",
			"Bash(*git *push*--all*)",
			"Bash(*git *push*--mirror*)",
			"Bash(*gh pr merge*)",
			"Bash(*gh pr ready*)",
			"Bash(*gh api*/merge*PUT*)",
			"Bash(*gh api*PUT*/merge*)",
			"Bash(*gh api*mergePullRequest*)",
			"Bash(*gh api*markPullRequestReadyForReview*)",
			"Bash(*glab mr merge*)",
			"Bash(*glab mr approve*)",
			"Bash(*glab mr update*--ready*)",
			"Bash(*glab mr update*--draft=false*)",
			"Bash(*glab api*/merge_requests/*/merge*PUT*)",
			"Bash(*glab api*PUT*/merge_requests/*/merge*)"
		]
	}
}
