#!/usr/bin/env bash
# Records every call and answers like Atlassian's acli for the Jira probe.
S=${PROBE_DIR:-$(dirname "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}
printf '%s\n' "$(printf '%q ' "$@")" >> "$S/acli-calls.log"
case "$1 $2 $3" in
  "jira auth status") echo "✓ Authenticated to datapizza.atlassian.net as matteopaludgnach@datapizza.tech"; exit 0;;
  "jira workitem view")
    case "$4" in
      DOS-396) printf 'Key: DOS-396\nType: Bug\nPriority: P1\nStatus: To Do\nAssignee: Unassigned\nSummary: Agent trace loses tool calls in the run transcript\nDescription: The run transcript drops tool-call entries when a step retries.\n';;
      DOS-363) printf 'Key: DOS-363\nType: Task\nPriority: P2\nStatus: To Do\nAssignee: Unassigned\nSummary: Run status does not refresh until reload\nDescription: The run list keeps the old status until the page reloads.\n';;
      *) echo "Work item not found" >&2; exit 1;;
    esac; exit 0;;
  "jira workitem search") printf 'key,issuetype,priority,status,summary\nDOS-396,Bug,P1,To Do,Agent trace loses tool calls in the run transcript\nDOS-363,Task,P2,To Do,Run status does not refresh until reload\n'; exit 0;;
  "jira workitem assign") echo "✓ Work item assigned"; exit 0;;
  "jira workitem transition") echo "✓ Work item transitioned"; exit 0;;
  "jira workitem comment") echo "✓ Done"; exit 0;;
esac
echo "✓ Done"; exit 0
