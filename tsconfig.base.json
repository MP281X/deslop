{
	"extends": "@deslop/coding-standards/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"jsx": "react-jsx",
		"lib": ["DOM", "ESNext", "DOM.Iterable"],
		"types": ["node", "vite-plus/client", "@deslop/coding-standards/css-properties"],
		"plugins": [
			{
				"name": "@effect/language-service",
				"overrides": [
					{"include": ["**/*.tsx"], "options": {"diagnosticSeverity": {"asyncFunction": "off"}}},
					{
						"include": ["**/*.gen.ts", "packages/components-web/src/svgs/**/*", "packages/components-web/src/ui/**/*"],
						"options": {
							"diagnosticSeverity": {
								"abortControllerInEffect": "off",
								"acquireReleaseDisposable": "off",
								"allOfMapToForEach": "off",
								"anyUnknownInErrorContext": "off",
								"apiStabilityLeak": "off",
								"asyncFunction": "off",
								"catchAllTagDispatchToCatchTag": "off",
								"catchAllToMapError": "off",
								"catchChainToFirstSuccessOf": "off",
								"catchConditionalRefailToCatchIf": "off",
								"catchDieToOrDie": "off",
								"catchIfTagToCatchTag": "off",
								"catchRefailToTapError": "off",
								"catchTagToCatchReason": "off",
								"catchToIgnore": "off",
								"catchToOrElseSucceed": "off",
								"catchUnfailableEffect": "off",
								"classSelfMismatch": "off",
								"cryptoRandomUUID": "off",
								"cryptoRandomUUIDInEffect": "off",
								"deterministicKeys": "off",
								"duplicatePackage": "off",
								"effectDoNotation": "off",
								"effectFnIife": "off",
								"effectFnImplicitAny": "off",
								"effectFnOpportunity": "off",
								"effectGenUsesAdapter": "off",
								"effectInFailure": "off",
								"effectInVoidSuccess": "off",
								"effectMapFlatten": "off",
								"effectMapVoid": "off",
								"effectSleepZeroToYieldNow": "off",
								"effectSucceedWithVoid": "off",
								"errorPayloadShadowsName": "off",
								"experimentalApiUsage": "off",
								"extendsNativeError": "off",
								"flatMapConditionalToFilterOrFail": "off",
								"flatMapIgnoredParamToAndThen": "off",
								"flatMapToMap": "off",
								"flatMapToTap": "off",
								"floatingEffect": "off",
								"floatingEffectInVitest": "off",
								"genericEffectServices": "off",
								"globalConsole": "off",
								"globalConsoleInEffect": "off",
								"globalDate": "off",
								"globalDateInEffect": "off",
								"globalErrorInEffectCatch": "off",
								"globalErrorInEffectFailure": "off",
								"globalFetch": "off",
								"globalFetchInEffect": "off",
								"globalRandom": "off",
								"globalRandomInEffect": "off",
								"globalTimers": "off",
								"globalTimersInEffect": "off",
								"instanceOfSchema": "off",
								"layerMergeAllWithDependencies": "off",
								"lazyEffect": "off",
								"lazyPromiseInEffectSync": "off",
								"leakingRequirements": "off",
								"mapSomeToAsSome": "off",
								"matchEffectToMapBoth": "off",
								"matchEffectToMatch": "off",
								"missedPipeableOpportunity": "off",
								"missingEffectContext": "off",
								"missingEffectError": "off",
								"missingEffectServiceDependency": "off",
								"missingLayerContext": "off",
								"missingPipeableSignature": "off",
								"missingReturnYieldStar": "off",
								"missingStarInYieldEffectGen": "off",
								"multipleCatchTag": "off",
								"multipleEffectProvide": "off",
								"nestedEffectGenYield": "off",
								"newPromise": "off",
								"newSchemaClass": "off",
								"nodeBuiltinImport": "off",
								"nonObjectEffectServiceType": "off",
								"obsoleteMatchImport": "off",
								"obsoleteSchemaImport": "off",
								"optionMatchToFromOption": "off",
								"outdatedApi": "off",
								"overriddenSchemaConstructor": "off",
								"preferBarrelImport": "off",
								"preferEffectArray": "off",
								"preferEffectRecord": "off",
								"preferEffectString": "off",
								"preferNamespaceImport": "off",
								"preferSchemaOverJson": "off",
								"preferSchemaTaggedError": "off",
								"preferSchemaTypeProperty": "off",
								"preferSucceedSomeOrNone": "off",
								"preferTypedSchemaDecoder": "off",
								"preferUnsafeConstructor": "off",
								"processEnv": "off",
								"processEnvInEffect": "off",
								"promiseInEffectSuccess": "off",
								"provideLayerSucceedToProvideService": "off",
								"raceFirstWithSleepToTimeout": "off",
								"redundantMapError": "off",
								"redundantOrDie": "off",
								"redundantSchemaTagIdentifier": "off",
								"returnEffectInGen": "off",
								"runEffectInsideEffect": "off",
								"runOfExitToRunExit": "off",
								"schemaClassMissingBrand": "off",
								"schemaClassObjectLiteral": "off",
								"schemaLiteralNonFinite": "off",
								"schemaNumber": "off",
								"schemaOpaqueInstanceMember": "off",
								"schemaStructWithTag": "off",
								"schemaSync": "off",
								"schemaSyncInEffect": "off",
								"schemaUnionOfLiterals": "off",
								"scopeInLayerEffect": "off",
								"serviceNotAsClass": "off",
								"strictBooleanExpressions": "off",
								"strictEffectProvide": "off",
								"syncToSucceed": "off",
								"timeoutCatchTagToTimeoutOrElse": "off",
								"tryCatchInEffectGen": "off",
								"unknownInEffectCatch": "off",
								"unnecessaryArrowBlock": "off",
								"unnecessaryEffectGen": "off",
								"unnecessaryFailYieldableError": "off",
								"unnecessaryPipe": "off",
								"unnecessaryPipeChain": "off",
								"unnecessaryTypeofType": "off",
								"unsafeEffectTypeAssertion": "off",
								"unstableApiUsage": "off",
								"unusedDirective": "off"
							}
						}
					}
				]
			}
		]
	},
	"exclude": [
		"${configDir}/**/node_modules",
		"${configDir}/**/dist",
		"${configDir}/**/.output",
		"${configDir}/**/.fixtures",
		"${configDir}/template",
		"${configDir}/ios",
		"${configDir}/android"
	]
}
