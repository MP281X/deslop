# Commands agents never run. Codex matches exact leading tokens, so these get through and only the prompts forbid them
# (pair's Branches, orchestrator's PR set): `git -C <dir> push`, `git push origin <branch>:main`, more than two push flags,
# an API call with the method after the endpoint, a GraphQL mutation, `gh stack submit --open` and `gh stack link --open`.
# Codex checks each rule's examples when it loads the file.

PROTECTED = [
    "main", "master", "+main", "+master", ":main", ":master", "main:main", "master:master",
    "HEAD:main", "HEAD:master", "+HEAD:main", "+HEAD:master",
    "refs/heads/main", "refs/heads/master", "+refs/heads/main", "+refs/heads/master",
    "HEAD:refs/heads/main", "HEAD:refs/heads/master", "+HEAD:refs/heads/main", "+HEAD:refs/heads/master",
]
PUSH_FLAGS = ["-f", "--force", "--force-with-lease", "--force-if-includes", "-u", "--set-upstream", "--no-verify", "--atomic", "--delete", "-d"]
WRITE_METHODS = ["POST", "PUT", "PATCH", "DELETE"]

prefix_rule(
    pattern = [["python", "python3"]],
    decision = "forbidden",
    justification = "Edit with apply_patch; query data with jq or an inline vp node script.",
    match = ["python3 -c 'print(1)'", "python script.py"],
    not_match = ["node -e 1"],
)
prefix_rule(
    pattern = ["sed", ["-i", "-i.bak", "--in-place", "--in-place=.bak"]],
    decision = "forbidden",
    justification = "Edit with apply_patch.",
    match = ["sed -i s/a/b/ file.ts", "sed --in-place=.bak s/a/b/ file.ts"],
    not_match = ["sed -n 1,20p file.ts"],
)
prefix_rule(
    pattern = ["sed", ["-E", "-r"], ["-i", "-i.bak"]],
    decision = "forbidden",
    justification = "Edit with apply_patch.",
    match = ["sed -E -i s/a/b/ file.ts"],
    not_match = ["sed -E -n 1p file.ts"],
)
prefix_rule(
    pattern = ["perl", ["-i", "-pi", "-pi.bak"]],
    decision = "forbidden",
    justification = "Edit with apply_patch.",
    match = ["perl -pi -e s/a/b/ file.ts"],
)
prefix_rule(
    pattern = ["git", "push", ["--all", "--mirror"]],
    decision = "forbidden",
    justification = "Never push every branch; publish only the thread's branches.",
    match = ["git push --all", "git push --mirror origin"],
)
prefix_rule(
    pattern = ["git", "push", "origin", ["--all", "--mirror"]],
    decision = "forbidden",
    justification = "Never push every branch; publish only the thread's branches.",
    match = ["git push origin --all"],
)
prefix_rule(
    pattern = ["git", "push", "origin", PROTECTED],
    decision = "forbidden",
    justification = "Never push to the default branch; open a draft pull request.",
    match = ["git push origin main", "git push origin HEAD:main"],
    not_match = ["git push origin t3/topic", "git push origin t3/topic-2-main"],
)
prefix_rule(
    pattern = ["git", "push", PUSH_FLAGS, "origin", PROTECTED],
    decision = "forbidden",
    justification = "Never push to the default branch; open a draft pull request.",
    match = ["git push --force-with-lease origin main", "git push -u origin master"],
    not_match = ["git push --force-with-lease origin t3/topic"],
)
prefix_rule(
    pattern = ["git", "push", PUSH_FLAGS, PUSH_FLAGS, "origin", PROTECTED],
    decision = "forbidden",
    justification = "Never push to the default branch; open a draft pull request.",
    match = ["git push --force-with-lease -u origin main"],
    not_match = ["git push --force-with-lease -u origin t3/topic"],
)
prefix_rule(
    pattern = ["git", "push", "origin", PUSH_FLAGS, PROTECTED],
    decision = "forbidden",
    justification = "Never push to the default branch; open a draft pull request.",
    match = ["git push origin --delete main"],
    not_match = ["git push origin --delete t3/topic"],
)
prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "The user merges pull requests.",
    match = ["gh pr merge 12 --squash"],
    not_match = ["gh pr view 12", "gh pr create --draft"],
)
prefix_rule(
    pattern = ["gh", "stack", "merge"],
    decision = "forbidden",
    justification = "The user merges pull requests.",
    match = ["gh stack merge 12"],
    not_match = ["gh stack sync --prune"],
)
prefix_rule(
    pattern = ["gh", "pr", "review"],
    decision = "forbidden",
    justification = "The user reviews and approves pull requests; findings go in the reply or a comment.",
    match = ["gh pr review 12 --approve"],
    not_match = ["gh pr comment 12 --body-file body.md"],
)
prefix_rule(
    pattern = ["glab", "mr", ["merge", "approve"]],
    decision = "forbidden",
    justification = "The user approves and merges merge requests.",
    match = ["glab mr merge 3", "glab mr approve 3"],
    not_match = ["glab mr update 3 --description-file body.md"],
)
prefix_rule(
    pattern = ["gh", "api", ["-X", "--method"], WRITE_METHODS],
    decision = "forbidden",
    justification = "Write through the gh commands delivery names.",
    match = ["gh api -X PUT repos/owner/name/pulls/1/merge"],
    not_match = ["gh api repos/owner/name/pulls/1"],
)
prefix_rule(
    pattern = ["glab", "api", ["-X", "--method"], WRITE_METHODS],
    decision = "forbidden",
    justification = "Write through the glab commands delivery names.",
    match = ["glab api --method PUT projects/1/merge_requests/3/merge"],
    not_match = ["glab api projects/1/pipelines/2/jobs"],
)
