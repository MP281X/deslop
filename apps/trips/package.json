{
	"name": "@deslop/trips",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/trips"
	},
	"bin": {
		"trips": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"main": "src/iphone/main.ts",
	"imports": {
		"#contracts": "./src/contracts.ts",
		"#journey": "./src/journey.ts",
		"#server/*": "./src/server/*",
		"#web/*": "./src/web/*",
		"#iphone/*": "./src/iphone/*",
		"#screens/*": "./src/screens/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp run build:server && vp run build:iphone",
		"build:iphone": "node bin/iphone.ts",
		"build:server": "vp build && vp pack",
		"iphone:prepare": "node bin/iphone.ts prepare",
		"preview": "vp run build:server && NODE_ENV=development node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"devDependencies": {
		"@bacons/apple-targets": "latest",
		"@deslop/components": "workspace:*",
		"@deslop/runtime": "workspace:*",
		"@effect/platform-node": "latest",
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@9eb76e60e47293cb0be63c12322a6bccd9e31add",
		"@effect/ui-kit": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-kit@9eb76e60e47293cb0be63c12322a6bccd9e31add",
		"@effect/ui-native": "https://pkg.pr.new/Effect-TS/ui/@effect/ui-native@9eb76e60e47293cb0be63c12322a6bccd9e31add",
		"effect": "latest",
		"expo": "latest",
		"expo-file-system": "latest",
		"expo-image-manipulator": "latest",
		"expo-notifications": "latest",
		"expo-secure-store": "latest",
		"expo-system-ui": "latest",
		"expo-updates": "latest",
		"expo-web-browser": "latest",
		"react": "latest",
		"react-native": "latest",
		"react-native-safe-area-context": "latest",
		"react-native-screens": "latest",
		"vite": "catalog:"
	},
	"config": {
		"port": 5109
	},
	"engines": {
		"node": ">=26"
	}
}
