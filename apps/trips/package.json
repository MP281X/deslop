{
	"name": "@deslop/trips",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/MP281X/deslop",
		"directory": "apps/trips"
	},
	"bin": {
		"trips": "./dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"main": "src/main.client.tsx",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"preview": "vp run build && node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts",
		"typecheck": "tsrs --checkerAssignment go --pretty false"
	},
	"dependencies": {
		"expo": "^58.0",
		"react": "latest",
		"react-native": "0.88.1"
	},
	"devDependencies": {
		"@deslop/components-mobile": "workspace:*",
		"@deslop/runtime": "workspace:*",
		"@effect/ai-anthropic": "latest",
		"@effect/atom-react": "latest",
		"@effect/platform-node": "latest",
		"@expo/ui": "^58.0",
		"@typeonce/effect-machine": "latest",
		"@typeonce/effect-machine-react": "latest",
		"effect": "latest",
		"expo-application": "^58.0",
		"expo-auth-session": "^58.0",
		"expo-calendar": "^58.0",
		"expo-clipboard": "^58.0",
		"expo-file-system": "^58.0",
		"expo-location": "^58.0",
		"expo-notifications": "^58.0",
		"expo-secure-store": "^58.0",
		"expo-updates": "^58.0",
		"expo-web-browser": "^58.0",
		"expo-widgets": "^58.0"
	},
	"config": {
		"port": 5109
	},
	"engines": {
		"node": ">=26"
	}
}
