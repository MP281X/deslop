{
	"name": "@deslop/gateway",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/gateway"
	},
	"bin": {
		"gateway": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#http/*": "./src/http/*",
		"#lib/*": "./src/lib/*",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*",
		"#tools/*": "./src/tools/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"preview": "vp run build && NODE_ENV=development node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"devDependencies": {
		"@deslop/runtime": "workspace:*",
		"@deslop/ui": "workspace:*",
		"@effect/platform-node": "latest",
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@87a704bef41b40de8fa7bced97cae5d69c4233a0",
		"@modelcontextprotocol/client": "latest",
		"effect": "latest"
	},
	"config": {
		"port": 5103
	},
	"engines": {
		"node": ">=26"
	}
}
