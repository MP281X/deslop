{
	"name": "@deslop/gateway",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/MP281X/deslop",
		"directory": "apps/gateway"
	},
	"bin": {
		"gateway": "./dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#http/*": "./src/http/*",
		"#lib/*": "./src/lib/*",
		"#package.*": "./package.*",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*",
		"#tools/*": "./src/tools/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && vp build && vp pack && node ../../packages/runtime/src/package.ts gateway",
		"preview": "vp run build && NODE_ENV=development node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts",
		"typecheck": "tsrs --checkerAssignment go --pretty false"
	},
	"devDependencies": {
		"@deslop/components-web": "workspace:*",
		"@deslop/runtime": "workspace:*",
		"@effect/atom-react": "latest",
		"@effect/platform-node": "latest",
		"@modelcontextprotocol/client": "latest",
		"@tanstack/react-router": "latest",
		"@typeonce/effect-machine": "latest",
		"@typeonce/effect-machine-react": "latest",
		"effect": "latest",
		"ipaddr.js": "latest",
		"lucide-react": "latest",
		"react": "latest",
		"react-dom": "latest"
	},
	"engines": {
		"node": ">=26"
	}
}
