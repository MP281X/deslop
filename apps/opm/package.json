{
	"name": "@deslop/opm",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": false,
	"main": "src/main.client.tsx",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#modules/*": "./modules/*",
		"#package.*": "./package.*",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*"
	},
	"scripts": {
		"build": "rm -rf dist && vp pack",
		"preview": "vp run build && node --env-file-if-exists=.env ./dist/server.js"
	},
	"dependencies": {
		"expo": "^58.0",
		"react": "latest",
		"react-native": "0.88.0"
	},
	"devDependencies": {
		"@deslop/components-mobile": "workspace:*",
		"@deslop/runtime": "workspace:*",
		"@effect/atom-react": "latest",
		"@effect/platform-node": "latest",
		"@expo/ui": "^58.0",
		"babel-preset-expo": "^58.0",
		"cheerio": "latest",
		"effect": "latest",
		"expo-auth-session": "^58.0",
		"expo-constants": "^58.0",
		"expo-file-system": "^58.0",
		"expo-notifications": "^58.0",
		"expo-secure-store": "^58.0",
		"expo-updates": "^58.0",
		"expo-web-browser": "^58.0"
	}
}
