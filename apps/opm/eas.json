{
	"cli": {"version": ">= 18.4.0", "appVersionSource": "local", "promptToConfigurePushNotifications": false},
	"build": {
		"base": {"pnpm": "12.16.1"},
		"simulator": {
			"extends": "base",
			"environment": "development",
			"channel": "development",
			"env": {"APP_VARIANT": "development"},
			"ios": {"simulator": true}
		},
		"production": {
			"extends": "base",
			"environment": "production",
			"distribution": "store",
			"channel": "production",
			"env": {"APP_VARIANT": "production"}
		}
	}
}
