{
	"name": "@deslop/portfolio",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/portfolio"
	},
	"bin": {
		"portfolio": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#server/*": "./src/server/*",
		"#web/*": "./src/web/*",
		"#contracts": "./src/contracts.ts"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"preview": "vp run build && NODE_ENV=development node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"devDependencies": {
		"@deslop/runtime": "workspace:*",
		"@deslop/ui": "workspace:*",
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@87a704bef41b40de8fa7bced97cae5d69c4233a0",
		"@fontsource-variable/geist": "latest",
		"@fontsource-variable/geist-mono": "latest",
		"@fontsource-variable/ibm-plex-sans": "latest",
		"effect": "latest",
		"tailwindcss": "latest"
	},
	"config": {
		"port": 5105
	},
	"engines": {
		"node": ">=26"
	}
}
