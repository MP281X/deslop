{
	"name": "@deslop/stash",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/stash"
	},
	"bin": {
		"stash": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"os": [
		"linux"
	],
	"cpu": [
		"x64"
	],
	"type": "module",
	"sideEffects": false,
	"main": "src/main.client.tsx",
	"imports": {
		"#http/*": "./src/http/*",
		"#lib/*": "./src/lib/*",
		"#modules/*": "./modules/*",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*",
		"#tools/*": "./src/tools/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "vp pack",
		"preview": "vp run build && node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"dependencies": {
		"expo": "^58.0.24",
		"react": "latest",
		"react-native": "0.88.1"
	},
	"devDependencies": {
		"@bacons/apple-targets": "latest",
		"@deslop/components-mobile": "workspace:*",
		"@deslop/runtime": "workspace:*",
		"@effect/ai-anthropic": "latest",
		"@effect/ai-openrouter": "latest",
		"@effect/atom-react": "latest",
		"@effect/platform-node": "latest",
		"@expo/ui": "^58.0.28",
		"@typeonce/effect-machine-react": "latest",
		"cheerio": "latest",
		"domhandler": "latest",
		"effect": "latest",
		"expo-auth-session": "^58.0.18",
		"expo-clipboard": "^58.0.4",
		"expo-crypto": "^58.0.8",
		"expo-file-system": "^58.0.13",
		"expo-secure-store": "^58.0.3",
		"expo-updates": "^58.0.22",
		"expo-web-browser": "^58.0.8"
	},
	"config": {
		"port": 5108
	},
	"engines": {
		"node": ">=26"
	}
}
