{
	"name": "@deslop/stash",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MP281X/deslop.git",
		"directory": "apps/stash"
	},
	"bin": {
		"stash": "dist/server.js"
	},
	"files": [
		"dist",
		"bin"
	],
	"os": [
		"linux"
	],
	"cpu": [
		"x64"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#contracts": "./src/contracts.ts",
		"#server/*": "./src/server/*",
		"#web/*": "./src/web/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"preview": "vp run build && node --env-file-if-exists=.env ./dist/server.js",
		"test": "vp test --config ../../vite.config.ts"
	},
	"devDependencies": {
		"@capacitor/cli": "latest",
		"@capacitor/core": "latest",
		"@capacitor/ios": "latest",
		"@deslop/runtime": "workspace:*",
		"@deslop/ui": "workspace:*",
		"@effect/platform-node": "latest",
		"@effect/sql-sqlite-node": "latest",
		"@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@87a704bef41b40de8fa7bced97cae5d69c4233a0",
		"cheerio": "latest",
		"domhandler": "latest",
		"effect": "latest"
	},
	"config": {
		"port": 5108
	},
	"engines": {
		"node": ">=26"
	}
}
