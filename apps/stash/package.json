{
	"name": "@deslop/stash",
	"version": "0.1.0",
	"description": "A personal inbox for links and notes: the server, the iOS app, and a CLI that saves to it.",
	"repository": {
		"type": "git",
		"url": "https://github.com/MP281X/deslop",
		"directory": "apps/stash"
	},
	"bin": {
		"stash": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#package": "./package.json",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && vp pack",
		"preview": "vp run build && HOST=127.0.0.1 PORT=5017 node --env-file-if-exists=$HOME/.deslop/stash.env ./dist/server.js"
	},
	"devDependencies": {
		"@deslop/runtime": "workspace:*",
		"@huggingface/transformers": "4.3.0",
		"cheerio": "latest",
		"onnxruntime-common": "1.30.0",
		"onnxruntime-node": "1.30.0",
		"sharp": "latest"
	},
	"engines": {
		"node": ">=26"
	}
}
