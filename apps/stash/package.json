{
	"name": "@deslop/stash",
	"version": "0.1.0",
	"description": "A personal inbox for links and notes: the server, the iOS app, and a CLI that saves to it.",
	"repository": {
		"type": "git",
		"url": "https://github.com/MP281X/deslop",
		"directory": "apps/stash"
	},
	"bin": {
		"stash": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "src/main.client.tsx",
	"imports": {
		"#lib/*": "./src/lib/*",
		"#modules/*": "./modules/*",
		"#package": "./package.json",
		"#routes/*": "./src/routes/*",
		"#rpcs/*": "./src/rpcs/*",
		"#services/*": "./src/services/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rm -rf dist && vp pack",
		"preview": "vp run build && HOST=127.0.0.1 PORT=5017 node --env-file-if-exists=$HOME/.deslop/stash.env ./dist/server.js"
	},
	"dependencies": {
		"expo": "^58.0.10",
		"react": "^19.3.1",
		"react-native": "0.88.0-rc.4"
	},
	"devDependencies": {
		"@bacons/apple-targets": "latest",
		"@deslop/components-mobile": "workspace:*",
		"@deslop/runtime": "workspace:*",
		"@effect/ai-anthropic": "4.0.4",
		"@expo/ui": "^58.0.17",
		"@huggingface/transformers": "4.3.1",
		"babel-preset-expo": "^58.0.14",
		"cheerio": "latest",
		"expo-clipboard": "^58.0.3",
		"expo-crypto": "^58.0.6",
		"expo-file-system": "^58.0.9",
		"expo-updates": "^58.0.16",
		"onnxruntime-common": "1.30.0",
		"onnxruntime-node": "1.30.0",
		"sharp": "latest"
	},
	"engines": {
		"node": ">=26"
	}
}
