{
	"name": "@deslop/scope",
	"version": "0.1.0",
	"type": "module",
	"sideEffects": false,
	"imports": {
		"#package.*": "./package.*",
		"#services/*": "./src/services/*",
		"#tools/*": "./src/tools/*"
	},
	"scripts": {
		"build": "rm -rf dist && vp pack",
		"test": "vp test --config ../../vite.config.ts",
