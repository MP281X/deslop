{
	"name": "@deslop",
	"type": "module",
	"scripts": {
		"build": "vp run -r build",
		"check": "vp check && fallow dead-code --format compact --fail-on-issues",
		"fix": "vp check --fix; status=$?; vp fmt && fallow dead-code --format compact --fail-on-issues && exit $status",
		"prepare": "effect-tsgo patch --no-typescript --oxlint --force"
	},
	"dependencies": {
		"@effect/atom-react": "latest",
		"@effect/platform-node": "latest",
		"effect": "latest"
	},
	"devDependencies": {
		"@deslop/coding-standards": "workspace:*",
		"@effect/tsgo": "latest",
		"@effect/vitest": "latest",
		"@types/node": "latest",
		"@types/react": "latest",
		"@types/react-dom": "latest",
		"fallow": "latest",
		"typescript": "latest",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "5.0.5"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.11.2"
}
