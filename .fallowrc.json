{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": ["**/main.*", "**/app.plugin.js", "apps/*/fingerprint.config.js", "tools/coding-standards/src/install.ts"],
	"includeEntryExports": true,
	"ignoreDependencies": [
		"@expo-google-fonts/jetbrains-mono",
		"babel-preset-expo",
		"expo-font",
		"expo-updates",
		"onnxruntime-common",
		"onnxruntime-node"
	],
	"ignorePatterns": ["**/*.gen.ts", "tools/*/template/**"],
	"ignoreExports": [
		{"exports": ["default"], "file": "apps/*/app.config.ts"},
		{"exports": ["*"], "file": "apps/*/fingerprint.config.js"},
		{"exports": ["default"], "file": "packages/*/app.plugin.js"},
		{"exports": ["*"], "file": "apps/*/src/services/*/schema.ts"},
		{"exports": ["*"], "file": "packages/components-web/src/**/*.tsx"}
	],
	"rules": {"require-suppression-reason": "error", "unlisted-dependencies": "off"}
}
