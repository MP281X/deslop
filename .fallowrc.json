{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": ["**/main.*", "apps/*/fingerprint.config.js", "apps/*/targets/*/expo-target.config.js"],
	"includeEntryExports": true,
	"publicPackages": ["@deslop/coding-standards"],
	"failOnParseError": true,
	"boundaries": {
		"zones": [
			{"name": "test", "patterns": ["apps/*/src/lib/*.test.ts", "packages/runtime/src/**/*.test.ts"]},
			{
				"name": "shared",
				"patterns": [
					"apps/*/src/services/*/{schema.ts,lib/utils.ts,lib/page.ts}",
					"apps/*/src/{rpcs,tools}/contracts.ts",
					"apps/portfolio/src/lib/portfolio.ts",
					"packages/*/src/shared/**"
				]
			},
			{
				"name": "client",
				"patterns": [
					"apps/*/index.html",
					"apps/*/src/main.client.tsx",
					"apps/*/src/routes/**",
					"apps/*/src/lib/*.ts",
					"apps/*/src/lib/*.tsx",
					"apps/portfolio/src/lib/profile.ts",
					"apps/*/modules/native/index.ts",
					"packages/components-*/src/**",
					"packages/*/src/{client,web,mobile}/**"
				]
			},
			// Server layers point one way: the entry composes transports, transports call services, services build on shared code.
			{"name": "entry", "patterns": ["apps/*/src/main.server.ts"]},
			{"name": "transport", "patterns": ["apps/*/src/{http,rpcs,tools}/handlers.ts"]},
			{
				"name": "server",
				// First match wins: schemas and pure helpers above stay shared; implementations default to server-only.
				"patterns": ["apps/*/src/services/**", "packages/*/src/server/**"]
			}
		],
		"rules": [
			{"from": "client", "allow": ["client", "shared"]},
			{"from": "shared", "allow": ["shared"]},
			{"from": "entry", "allow": ["entry", "transport", "server", "shared"]},
			{"from": "transport", "allow": ["transport", "server", "shared"]},
			{"from": "server", "allow": ["server", "shared"]}
		],
		// Configuration, files and stores are the server's; shared code also holds no client state.
		"calls": {
			"forbidden": [
				{"from": "shared", "callee": ["Config.*", "FileSystem.*", "SqlClient.*", "Atom.*", "AsyncResult.*"]},
				{"from": "client", "callee": ["Config.*", "FileSystem.*", "SqlClient.*"]}
			]
		},
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": [
				"tools/**",
				"packages/components-mobile/bin/**",
				"**/*.config.*",
				"**/*.test.ts",
				"apps/*/fingerprint.config.js",
				"apps/*/targets/**",
				"packages/runtime/src/config/**"
			]
		}
	},
	// Extract shared logic at this size; mark imports, schema fields and modifier/prop lists inline as shape-only clones.
	"duplicates": {"minTokens": 50, "minLines": 5},
	"health": {
		"maxCognitive": 14,
		// No production coverage exists: estimated CRAP must not masquerade as measured risk.
		"maxCrap": 0,
		"ignore": ["packages/components-web/src/ui/**"]
	},
	"ignoreDependencies": [
		// Peer-only: one scheduler resolution keeps app and shared atom hooks on the same registry context.
		"scheduler",
		// The runtime imports these; each app keeps them so autolinking includes their native modules.
		"expo-auth-session",
		"expo-secure-store",
		"expo-updates",
		"expo-web-browser"
	],
	"ignorePatterns": ["**/*.gen.ts", "tools/*/template/**"],
	"ignoreExports": [
		{"exports": ["default"], "file": "apps/*/app.config.ts"},
		{"exports": ["*"], "file": "apps/*/fingerprint.config.js"},
		{"exports": ["module.exports"], "file": "apps/*/targets/*/expo-target.config.js"},
		{"exports": ["*"], "file": "apps/*/src/services/*/schema.ts"},
		{"exports": ["*"], "file": "packages/components-web/src/ui/**/*.{ts,tsx}"}
	],
	"overrides": [
		{
			// shadcn's CLI owns these files and their exported prop types.
			"files": ["packages/components-web/src/ui/**"],
			"rules": {"private-type-leaks": "off"}
		}
	],
	"rules": {
		"dev-dependencies-in-production": "error",
		"duplicate-export-aliases": "error",
		"empty-catalog-groups": "error",
		// Components build on the runtime, never the reverse.
		"package-cycle": "error",
		"policy-violation": "off",
		"private-type-leaks": "error",
		"prop-drilling": "error",
		"re-export-cycle": "error",
		"require-suppression-reason": "error",
		"stale-suppressions": "error",
		"test-only-dependencies": "error",
		"thin-wrapper": "error",
		"type-only-dependencies": "error",
		"unlisted-binaries": "error",
		"unlisted-dependencies": "error",
		"unused-catalog-entries": "error",
		"unused-dependency-overrides": "error",
		"unused-dev-dependencies": "error",
		"unused-namespace-members": "error",
		"unused-optional-dependencies": "error"
	}
}
