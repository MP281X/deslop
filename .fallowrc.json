{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": ["**/main.*", "apps/*/fingerprint.config.js", "apps/*/targets/*/expo-target.config.js"],
	"includeEntryExports": true,
	"publicPackages": ["@deslop/coding-standards"],
	"failOnParseError": true,
	"boundaries": {
		"zones": [
			{
				"name": "client",
				"patterns": [
					"apps/*/index.html",
					"apps/*/src/main.client.tsx",
					"apps/*/src/routes/**",
					"apps/*/src/lib/{utils.ts,components.tsx}",
					"apps/*/modules/native/index.ts",
					"packages/components-*/src/**",
					"packages/runtime/src/{web,mobile}/client.ts",
					"packages/runtime/src/mobile/session.ts"
				]
			},
			{
				"name": "shared",
				"patterns": [
					"apps/*/src/services/*/{schema.ts,lib/utils.ts,lib/page.ts}",
					"apps/*/src/{rpcs,tools}/contracts.ts",
					"apps/portfolio/src/lib/portfolio.ts",
					"packages/runtime/src/auth/schema.ts",
					"packages/runtime/src/auth/lib/utils.ts",
					"packages/runtime/src/telemetry.ts"
				]
			},
			{
				"name": "server",
				"patterns": [
					"apps/*/src/main.server.ts",
					// First match wins: schemas and pure helpers above stay shared; implementations default to server-only.
					"apps/*/src/services/**",
					"apps/*/src/{rpcs,tools}/handlers.ts",
					"packages/runtime/src/auth/service.ts",
					"packages/runtime/src/server.ts"
				]
			}
		],
		"rules": [
			{"from": "client", "allow": ["client", "shared"]},
			{"from": "shared", "allow": ["shared"]},
			{"from": "server", "allow": ["server", "shared"]}
		],
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": [
				"tools/**",
				"**/*.config.*",
				"**/*.test.ts",
				"**/app.plugin.js",
				"apps/*/fingerprint.config.js",
				"apps/*/targets/**",
				"packages/runtime/src/vite.ts",
				"packages/runtime/src/mobile/expo.ts"
			]
		}
	},
	"health": {
		// No production coverage exists: estimated CRAP must not masquerade as measured risk.
		"maxCrap": 0,
		"thresholdOverrides": [
			{
				"files": ["tools/coding-standards/src/rules/shared.ts"],
				"functions": ["referencedTypeNames"],
				"maxCognitive": 17,
				"reason": "One recursive visitor follows TypeScript's finite type-node variants."
			},
			{
				"files": ["apps/stash/src/services/notes/lib/extraction.ts"],
				"functions": ["isPublic"],
				"maxCyclomatic": 22,
				"reason": "Keep the public IPv4 exclusions together for security review."
			}
		]
	},
	"ignoreDependencies": [
		"@expo-google-fonts/jetbrains-mono",
		// The runtime's session imports it; each app keeps it so autolinking builds its native modules.
		"expo-auth-session",
		"expo-font",
		"expo-updates",
		"onnxruntime-common",
		"onnxruntime-node",
		// The typecheck task uses sh for glob expansion; Fallow does not inspect its command string.
		"tsrs"
	],
	"ignorePatterns": ["**/*.gen.ts", "tools/*/template/**"],
	"ignoreExports": [
		{"exports": ["default"], "file": "apps/*/app.config.ts"},
		{"exports": ["*"], "file": "apps/*/fingerprint.config.js"},
		{"exports": ["module.exports"], "file": "apps/*/targets/*/expo-target.config.js"},
		{"exports": ["default"], "file": "packages/*/app.plugin.js"},
		{"exports": ["*"], "file": "apps/*/src/services/*/schema.ts"},
		{"exports": ["*"], "file": "packages/components-web/src/ui/**/*.tsx"}
	],
	"rules": {"policy-violation": "off", "require-suppression-reason": "error", "unlisted-dependencies": "error"}
}
