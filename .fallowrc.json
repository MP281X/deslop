{
	"$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
	"entry": ["**/main.*", "**/app.plugin.js", "apps/*/fingerprint.config.js", "tools/coding-standards/src/install.ts"],
	"includeEntryExports": true,
	"ignoreDependencies": [
		"@expo-google-fonts/jetbrains-mono",
		"babel-preset-expo",
		"expo-font",
		"expo-updates",
		"onnxruntime-common",
		"onnxruntime-node"
	],
	"ignorePatterns": ["**/*.gen.ts", "packages/components-web/src/svgs/**", "tools/*/template/**"],
	"ignoreExports": [
		{"exports": ["*"], "file": "packages/*/src/schema.ts"},
		{"exports": ["*"], "file": "apps/stash/src/services/*/schema.ts"},
		{"exports": ["default"], "file": "apps/*/app.config.ts"},
		{"exports": ["*"], "file": "apps/*/fingerprint.config.js"},
		{"exports": ["default"], "file": "packages/*/app.plugin.js"},
		{"exports": ["*"], "file": "packages/components-web/src/*.tsx"},
		{"exports": ["*"], "file": "packages/components-web/src/{ui,render,svgs}/**"}
	],
	"rules": {"require-suppression-reason": "error"}
}
