{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": ["**/main.*"],
	"includeEntryExports": true,
	"publicPackages": ["@deslop/coding-standards"],
	"failOnParseError": true,
	"boundaries": {
		"zones": [
			// Tests and tooling may read any zone, and no shipped zone may read them, so neither bridges client and server.
			{"name": "test", "patterns": ["**/*.test.ts"]},
			{"name": "tooling", "patterns": ["tools/**", "vite.config.ts", "apps/*/vite.config.ts"]},
			// Build configuration the server also reads; it imports no zone, so it carries nothing across.
			{"name": "config", "patterns": ["packages/runtime/src/config/**", "packages/ui/src/vite.ts"]},
			{
				"name": "shared",
				"patterns": [
					"apps/*/src/services/*/{schema.ts,lib/utils.ts,lib/page.ts}",
					"apps/*/src/{rpcs,tools}/contracts.ts",
					"apps/portfolio/src/lib/portfolio.ts",
					"packages/*/src/shared/**"
				]
			},
			{
				"name": "client",
				"patterns": [
					"apps/*/index.html",
					"apps/*/src/main.client.ts",
					"apps/*/src/routes/**",
					"apps/*/src/lib/*.ts",
					"apps/portfolio/src/lib/profile.ts",
					"packages/ui/src/**",
					"packages/*/src/{client,web}/**"
				]
			},
			// Server layers point one way: the entry composes transports, transports call services, services build on shared code.
			{"name": "entry", "patterns": ["apps/*/src/main.server.ts"]},
			{"name": "transport", "patterns": ["apps/*/src/{http,rpcs,tools}/handlers.ts"]},
			{
				"name": "server",
				// First match wins: schemas and pure helpers above stay shared; implementations default to server-only.
				"patterns": ["apps/*/src/services/**", "packages/*/src/server/**"]
			}
		],
		"rules": [
			{"from": "config", "allow": ["config"]},
			{"from": "client", "allow": ["client", "shared"]},
			{"from": "shared", "allow": ["shared"]},
			{"from": "entry", "allow": ["entry", "transport", "server", "shared"]},
			{"from": "transport", "allow": ["transport", "server", "shared"]},
			{"from": "server", "allow": ["server", "shared", "config"]}
		],
		// Configuration, files and stores are the server's; shared code also holds no client state.
		"calls": {
			"forbidden": [
				{"from": "shared", "callee": ["Config.*", "FileSystem.*", "SqlClient.*", "Atom.*", "AsyncResult.*"]},
				{"from": "client", "callee": ["Config.*", "FileSystem.*", "SqlClient.*"]}
			]
		},
		"coverage": {"requireAllFiles": true}
	},
	// Extract shared logic at this size; mark imports, schema fields and modifier/prop lists inline as shape-only clones.
	"duplicates": {"minTokens": 50, "minLines": 5, "ignore": ["apps/*/src/services/*/migrations.ts"]},
	"health": {
		"maxCognitive": 14,
		"thresholdOverrides": [
			{"files": ["**/handlers.ts"], "maxCognitive": 8, "reason": "Transport handlers delegate decisions to services."}
		],
		// No production coverage exists: estimated CRAP must not masquerade as measured risk.
		"maxCrap": 0
	},
	"ignoreDependencies": [
		// Capacitor CLI copies this platform's native project; it has no JS clients.
		"@capacitor/ios"
	],
	"ignorePatterns": ["**/*.gen.ts", "tools/*/template/**"],
	"overrides": [
		{
			// Schemas and their types are exported in pairs by policy
			"files": ["apps/*/src/services/*/schema.ts", "packages/runtime/src/shared/schema.ts"],
			"rules": {"unused-exports": "off", "unused-types": "off"}
		},
		{
			// A shared codec's type is exported beside it even where callers read only the value.
			"files": ["packages/runtime/src/shared/{auth,time}.ts"],
			"rules": {"unused-types": "off"}
		}
	],
	"rules": {
		"deprecated-exports-in-use": "error",
		"dev-dependencies-in-production": "error",
		"duplicate-export-aliases": "error",
		"empty-catalog-groups": "error",
		// Components build on the runtime, never the reverse.
		"package-cycle": "error",
		"policy-violation": "off",
		"private-type-leaks": "error",
		"prop-drilling": "error",
		"re-export-cycle": "error",
		"require-suppression-reason": "error",
		"stale-suppressions": "error",
		"test-only-dependencies": "error",
		"thin-wrapper": "error",
		"type-only-dependencies": "error",
		"unlisted-binaries": "error",
		"unlisted-dependencies": "error",
		"unproduced-catch-tags": "error",
		"unused-component-props": "error",
		"unused-effect-layers": "error",
		"unused-store-members": "error",
		"unused-tagged-errors": "error",
		"unused-catalog-entries": "error",
		"unused-dependency-overrides": "error",
		"unused-dev-dependencies": "error",
		"unused-namespace-members": "error",
		"unused-optional-dependencies": "error"
	}
}
