{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": ["**/main.*", "apps/*/fingerprint.config.js", "apps/*/targets/*/expo-target.config.js"],
	"includeEntryExports": true,
	"publicPackages": ["@deslop/coding-standards"],
	"failOnParseError": true,
	"boundaries": {
		"zones": [
			// Tests and tooling may read any zone, and no shipped zone may read them, so neither bridges client and server.
			{"name": "test", "patterns": ["**/*.test.ts"]},
			{
				"name": "tooling",
				"patterns": [
					"tools/**",
					"packages/{components,runtime}/src/tooling/**",
					"vite.config.ts",
					"apps/*/{app,metro,vite}.config.ts",
					"apps/*/fingerprint.config.js",
					"apps/*/targets/*/expo-target.config.js",
					"apps/*/bin/iphone.ts"
				]
			},
			// Build configuration the server also reads; it imports no zone, so it carries nothing across.
			{"name": "config", "patterns": ["packages/runtime/src/config/**"]},
			// An app organised by feature: each feature folder holds its contract and shared logic, its screen and view, and its server.
			{
				"name": "client",
				"patterns": [
					"apps/*/index.html",
					"apps/*/src/{iphone,screens,web}/**",
					"apps/*/src/{app,reads,view}.ts",
					"apps/*/src/*/{screen,view}.ts",
					"packages/components/gallery/**",
					"packages/components/src/native/**",
					"packages/runtime/src/iphone/**",
					"packages/*/src/{client,web}/**"
				]
			},
			// Server layers point one way: the entry composes transports, transports call services, services build on shared code.
			{"name": "entry", "patterns": ["apps/*/src/server/main.ts", "apps/*/src/server.ts"]},
			{
				"name": "shared",
				"patterns": ["apps/*/src/*.ts", "apps/*/src/*/{contract,shared}.ts", "packages/*/src/shared/**"]
			},
			{"name": "transport", "patterns": ["apps/*/src/server/*/{http,rpcs,tools}.ts", "apps/*/src/*/handlers.ts"]},
			{
				"name": "server",
				// First match wins: contracts above stay shared; implementations default to server-only.
				"patterns": ["apps/*/src/server/**", "apps/*/src/*/**", "packages/*/src/server/**"]
			}
		],
		"rules": [
			{"from": "config", "allow": ["config"]},
			{"from": "client", "allow": ["client", "shared"]},
			{"from": "shared", "allow": ["shared"]},
			{"from": "entry", "allow": ["entry", "transport", "server", "shared"]},
			{"from": "transport", "allow": ["transport", "server", "shared"]},
			{"from": "server", "allow": ["server", "shared", "config"]}
		],
		// Configuration, files and stores are the server's; shared code also holds no client state.
		"calls": {
			"forbidden": [
				{"from": "shared", "callee": ["Config.*", "FileSystem.*", "SqlClient.*", "Atom.*", "AsyncResult.*"]},
				{"from": "client", "callee": ["Config.*", "FileSystem.*", "SqlClient.*"]}
			]
		},
		"coverage": {"requireAllFiles": true}
	},
	// Extract shared logic at this size; mark imports, schema fields and modifier/prop lists inline as shape-only clones.
	"duplicates": {
		"minTokens": 50,
		"minLines": 5,
		"ignore": ["apps/*/src/server/*/migrations.ts", "apps/*/src/*/migrations.ts"]
	},
	"health": {
		"maxCognitive": 14,
		"thresholdOverrides": [
			{
				"files": ["apps/*/src/server/*/{http,rpcs,tools}.ts", "apps/*/src/*/handlers.ts"],
				"maxCognitive": 8,
				"reason": "Transport handlers delegate decisions to services."
			}
		],
		// No production coverage exists: estimated CRAP must not masquerade as measured risk.
		"maxCrap": 0
	},
	"ignoreDependencies": [
		// Expo reads these in native linking and app configuration, not through a JS import.
		"expo-system-ui"
	],
	"ignoreExports": [
		// Each app names its own contract groups; the same name in two apps is two separate APIs.
		{"file": "apps/*/src/contracts.ts", "exports": ["RpcContracts", "PushRpcs"]},
		// The separately linted app template calls these when configuring and building its iPhone app.
		{"file": "packages/runtime/src/config/iphone.ts", "exports": ["iphoneUpdates"]},
		{"file": "packages/runtime/src/config/iphone-export.ts", "exports": ["writeIPhoneExport"]},
		// Expo's fingerprint and apple-targets load these configurations by file name, not through an import.
		{"file": "apps/*/fingerprint.config.js", "exports": ["*"]},
		{"file": "apps/*/targets/*/expo-target.config.js", "exports": ["*"]}
	],
	"ignorePatterns": ["**/*.gen.ts", "tools/*/template/**"],
	"overrides": [
		{
			// Schemas and their types are exported in pairs by policy
			"files": [
				"apps/*/src/server/*/schema.ts",
				"apps/*/src/contracts.ts",
				"apps/*/src/*/contract.ts",
				"packages/runtime/src/shared/schema.ts"
			],
			"rules": {"unused-exports": "off", "unused-types": "off"}
		},
		{
			// A shared codec's type is exported beside it even where callers read only the value.
			"files": ["packages/runtime/src/shared/{auth,time}.ts"],
			"rules": {"unused-types": "off"}
		}
	],
	"rules": {
		"deprecated-exports-in-use": "error",
		"dev-dependencies-in-production": "error",
		"duplicate-export-aliases": "error",
		"empty-catalog-groups": "error",
		// The runtime's app shell builds on components, never the reverse.
		"package-cycle": "error",
		"policy-violation": "off",
		"private-type-leaks": "error",
		"prop-drilling": "error",
		"re-export-cycle": "error",
		"require-suppression-reason": "error",
		"stale-suppressions": "error",
		"test-only-dependencies": "error",
		"thin-wrapper": "error",
		"type-only-dependencies": "error",
		"unlisted-binaries": "error",
		"unlisted-dependencies": "error",
		"unproduced-catch-tags": "error",
		"unused-component-props": "error",
		"unused-effect-layers": "error",
		"unused-store-members": "error",
		"unused-tagged-errors": "error",
		"unused-catalog-entries": "error",
		"unused-dependency-overrides": "error",
		"unused-dev-dependencies": "error",
		"unused-namespace-members": "error",
		"unused-optional-dependencies": "error"
	}
}
