{
	"$schema": "./node_modules/fallow/schema.json",
	"entry": ["**/main.*", "apps/*/fingerprint.config.js", "apps/*/targets/*/expo-target.config.js"],
	"includeEntryExports": true,
	"publicPackages": ["@deslop/coding-standards"],
	"failOnParseError": true,
	"boundaries": {
		"zones": [
			{"name": "test", "patterns": ["apps/*/src/lib/*.test.ts"]},
			{
				"name": "shared",
				"patterns": [
					"apps/*/src/services/*/{schema.ts,lib/utils.ts,lib/page.ts}",
					"apps/*/src/{rpcs,tools}/contracts.ts",
					"apps/portfolio/src/lib/portfolio.ts",
					"packages/runtime/src/ai/schema.ts",
					"packages/runtime/src/auth/schema.ts",
					"packages/runtime/src/auth/lib/utils.ts",
					"packages/runtime/src/net.ts",
					"packages/runtime/src/rpc.ts",
					"packages/runtime/src/schema.ts",
					"packages/runtime/src/telemetry.ts"
				]
			},
			{
				"name": "client",
				"patterns": [
					"apps/*/index.html",
					"apps/*/src/main.client.tsx",
					"apps/*/src/routes/**",
					"apps/*/src/lib/*.ts",
					"apps/*/src/lib/*.tsx",
					"apps/portfolio/src/lib/profile.ts",
					"apps/*/modules/native/index.ts",
					"packages/components-*/src/**",
					"packages/runtime/src/{web,mobile}/client.{ts,tsx}",
					"packages/runtime/src/mobile/{activations,session,keychain}.ts"
				]
			},
			{
				"name": "server",
				"patterns": [
					"apps/*/src/main.server.ts",
					// First match wins: schemas and pure helpers above stay shared; implementations default to server-only.
					"apps/*/src/services/**",
					"apps/*/src/{http,rpcs,tools}/handlers.ts",
					"packages/runtime/src/auth/{service,sessions,routes}.ts",
					"packages/runtime/src/ai/service.ts",
					"packages/runtime/src/server.ts",
					"packages/runtime/src/cli.ts",
					"packages/runtime/src/cli/**"
				]
			}
		],
		"rules": [
			{"from": "client", "allow": ["client", "shared"]},
			{"from": "shared", "allow": ["shared"]},
			{"from": "server", "allow": ["server", "shared"]}
		],
		"coverage": {
			"requireAllFiles": true,
			"allowUnmatched": [
				"tools/**",
				"**/*.config.*",
				"**/*.test.ts",
				"apps/*/fingerprint.config.js",
				"apps/*/targets/**",
				"packages/runtime/src/vite.ts",
				"packages/runtime/src/mobile/expo.ts",
				"packages/runtime/src/mobile/fingerprint.js",
				"packages/runtime/src/mobile/metro.ts"
			]
		}
	},
	// Below these, the clones are imports, schema fields and SwiftUI modifier lists: shapes, not shared logic.
	"duplicates": {"minTokens": 100, "minLines": 10},
	"health": {
		// No production coverage exists: estimated CRAP must not masquerade as measured risk.
		"maxCrap": 0,
		"ignore": ["packages/components-web/src/ui/**"]
	},
	"ignoreDependencies": [
		// Peer-only: one scheduler resolution keeps app and shared atom hooks on the same registry context.
		"scheduler",
		// The runtime imports these; each app keeps them so autolinking includes their native modules.
		"expo-auth-session",
		"expo-secure-store",
		"expo-updates",
		"expo-web-browser"
	],
	"ignorePatterns": ["**/*.gen.ts", "tools/*/template/**"],
	"ignoreExports": [
		// Test fixtures choose an isolated AI usage directory and compute the expected report; production uses AiProxy.layer and the service's read.
		{"exports": ["layerAiProxy"], "file": "apps/gateway/src/services/ai/service.ts"},
		{"exports": ["report"], "file": "apps/gateway/src/services/ai/usage.ts"},
		{"exports": ["default"], "file": "apps/*/app.config.ts"},
		{"exports": ["*"], "file": "apps/*/fingerprint.config.js"},
		{"exports": ["module.exports"], "file": "apps/*/targets/*/expo-target.config.js"},
		{"exports": ["*"], "file": "apps/*/src/services/*/schema.ts"},
		{"exports": ["*"], "file": "packages/components-web/src/ui/**/*.{ts,tsx}"}
	],
	"overrides": [
		{
			// shadcn's CLI owns these files and their exported prop types.
			"files": ["packages/components-web/src/ui/**"],
			"rules": {"private-type-leaks": "off"}
		}
	],
	"rules": {
		"policy-violation": "off",
		"private-type-leaks": "error",
		"prop-drilling": "error",
		"require-suppression-reason": "error",
		"thin-wrapper": "error",
		"unlisted-dependencies": "error"
	}
}
